# Copy to backend/.env (git-ignored) and fill in. Real environment variables take precedence.

# Gemini API key for /rag/query and /voice/nlu answers (free key: https://aistudio.google.com/apikey).
# Without it, answers quote the best-matching manual section instead.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Retrieval: "embeddings" (multilingual sentence-transformers, ~470 MB download on first run) or "tfidf".
# RAG_RETRIEVER=embeddings
# RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
