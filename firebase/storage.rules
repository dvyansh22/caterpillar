rules_version = '2';
// Storage: 3D models, training videos, incident media. Signed-in read; scoped writes.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // tighten to org/owner paths in Phase 1
    }
  }
}
